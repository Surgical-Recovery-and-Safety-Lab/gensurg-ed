{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gensurg-ed",
  "compatibility_date": "2026-05-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Serve the whole repo root so /data/ and /app/ are both reachable.
    // The app lives at /app/ and iframes load notes from /data/.
    "directory": ".",
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
